{
  "manifest_version": 3,
  "name": "Tab Pressure",
  "version": "1.0.0",
  "description": "Estimate which Safari tabs weigh the most, then close, pin, copy, or clear site data from one panel.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["estimate.js", "background.js"]
  },
  "action": {
    "default_title": "Tab Pressure",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.0"
    }
  }
}
